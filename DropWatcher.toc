## Interface: 120100
## Title: Ka0s Drop Watcher
## Notes: Watches your group's loot, shows who each drop is an upgrade for and whether it can be traded, and asks for it politely in one click.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\DropWatcher\media\logos\dropwatcher.logo.128.tga
## SavedVariables: DropWatcherDB, DropWatcherPerfDB
## OptionalDeps: Pawn, CanIMogIt, Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Group
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
# X-Curse-Project-ID: not published on CurseForge yet

# Libraries (must load first) -- vendored in libs/, .xml where the lib ships one, else .lua
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
# LOAD-BEARING: AceConfigDialog-3.0 resolves AceGUI-3.0 with a non-silent LibStub at file load, so
# AceConfig-3.0.xml sits below AceGUI-3.0.xml. AceDBOptions resolves nothing at load.
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
# LOAD-BEARING: LibDBIcon-1.0 errors at file load unless LibDataBroker-1.1 is already registered, so
# LibDataBroker-1.1.lua sits above its lib.xml. LibKa0s-Launcher-1.0 resolves both at Register time.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\lib.xml
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml

# Locales
# LOAD-BEARING: publishes NS.L, which every file below reads at load.
locales\enUS.lua

# Core -- dependency-correct order (layout-§1)
# LOAD-BEARING: publishes NS.name, NS.BRAND, NS.PREFIX and NS.SLASH, read at load below.
core\Namespace.lua
# LOAD-BEARING: publishes NS.Print / NS.Util.print and NS.LIBKA0S_MISSING, read at load below.
core\CoreSetup.lua
# LOAD-BEARING: publishes NS.TextParse (the pure text parsers, no client call), which core\Compat.lua
# takes at load just below.
core\TextParse.lua
# LOAD-BEARING: takes NS.TextParse (core\TextParse.lua, the line above) at load, and LibStub.
# NS.Compat (every version-variant client call and the secret guards) is read inside functions only.
core\Compat.lua
# LOAD-BEARING: adds the stable world reads (the group, a unit, the instance) to NS.Compat; it
# loads before core\SimSeam.lua (below), which wraps every member at load. Read inside functions only.
core\CompatWorld.lua
# LOAD-BEARING: adds the exact item reads at a bag location and the game tooltip's item setters to
# NS.Compat; it loads before core\SimSeam.lua (below), which wraps every member at load. Read
# inside functions only.
core\CompatItem.lua
# LOAD-BEARING: publishes NS.Sim (the simulator's answer seam) and wraps every NS.Compat member that
# answers for the client, at load, right after core\Compat.lua and core\CompatWorld.lua and before any
# file below reads one.
# It needs NS.Compat (above), NS.Print and NS.L (above) at load.
core\SimSeam.lua
# LOAD-BEARING: publishes NS.MediaFont, which core\Constants.lua resolves FONT_MONO from at load.
core\MediaSetup.lua
# LOAD-BEARING: publishes the NS.Constants id tables, which core\ClassData.lua reads at load; FONT_MONO
# is resolved from the seam above.
core\Constants.lua
# LOAD-BEARING: reads NS.Constants' ARMOR_SUBCLASS and WEAPON_SUBCLASS (core\Constants.lua, the line
# above) at load. NS.ClassData, data plus pure lookups, is read by the feature modules at call time.
core\ClassData.lua
# Conventional: session-only state (NS.State), read by everything below at call time.
core\State.lua
# Conventional: NS.Meta / NS.Version are read inside functions only.
core\EnvSetup.lua
# Conventional: NS.Pool is read inside functions only.
core\PoolSetup.lua
# Conventional: NS.Item is read inside functions only.
core\ItemSetup.lua
# Conventional: publishes NS.ItemRead (the library-shaped item reads: how complete a link is, the
# better of two, level and quality read the exact way); reads NS.Compat and NS.Item (above) at call
# time only.
core\ItemRead.lua
# Conventional: NS.MakeDropdown / NS.CloseMenu are read inside functions only (the window's
# filter bar and footer, built on the first show).
core\WidgetsSetup.lua
# LOAD-BEARING: publishes NS.MSG (the message catalog) and NS.Bus; every file that names a message
# takes NS.MSG at load.
core\Bus.lua
# LOAD-BEARING relative to core\PerfSetup.lua only, which hands NS.Lifecycle to lib:New at load.
core\LifecycleSetup.lua
# LOAD-BEARING: lib:New reads NS.Lifecycle (above) at load, and modules\Window.lua takes
# `local Perf = NS.Perf` as a load-time upvalue (below).
core\PerfSetup.lua
# LOAD-BEARING: the lib:New descriptor reads NS.Constants.FONT_MONO (core\Constants.lua, above) at
# load; publishes NS.Debug before any call site runs.
core\DebugLogSetup.lua
# LOAD-BEARING: promotes NS to the AceAddon object (NS.addon) and reclaims NS.Print; modules\ and
# settings\ read NS.addon at load.
core\DropWatcher.lua
# Conventional: NS:RunMigrations is called from OnInitialize.
core\Database.lua
# Conventional: the launcher is built here and registered from OnEnable.
core\LauncherSetup.lua

# Defaults
# LOAD-BEARING: publishes NS.C, which settings\Schema.lua, settings\SchemaRows.lua and settings\Panel.lua
# take at load, and so do modules\QualityGate.lua, modules\Situations.lua, modules\TradeRules.lua and
# modules\WindowFilterBar.lua (their defaults, as file-scope upvalues); modules\Messaging.lua,
# modules\TradeTimer.lua and modules\MineCells.lua read it at call time. It stays above every module.
defaults\Profile.lua

# Modules
# LOAD-BEARING: publishes the simulator's session on NS.Sim (core\SimSeam.lua, above). It is the first
# module so its GROUP_ROSTER_UPDATE, PLAYER_ENTERING_WORLD and ZONE_CHANGED_NEW_AREA rows run before
# every other module's (the automatic stop, before anything reads the client) and its STAND_DOWN
# step runs first (the stop cleans up while every module still holds its state). Appends to
# NS.FEATURE_EVENTS and NS.STAND_DOWN and its handler to NS.addon (core\DropWatcher.lua) at load;
# every module below is read at call time.
modules\Sim.lua
# Conventional: publishes NS.Evaluate, the pure verdict kernel; read by the feature modules at call
# time only, and itself reads NS.Constants and NS.ClassData (core\, above) at load.
modules\Evaluate.lua
# Conventional: publishes NS.Scoring, the scorers behind the kernel's opts.scorer (Pawn, your weights,
# none); read by the feed and the diagnostics at call time only, and itself reads NS.ClassData
# (core\, above) at load. NS.Compat's Pawn seam, NS.Setting and NS.DebugOnce are read at call time.
modules\Scoring.lua
# Conventional: publishes NS.QualityGate, the pure minimum-quality gate; read by the feed at call
# time only, and itself reads NS.Constants (core\, above), NS.L (locales\, above) and NS.C
# (defaults\, above) at load.
modules\QualityGate.lua
# LOAD-BEARING: appends its PLAYER_ENTERING_WORLD row to NS.FEATURE_EVENTS after modules\Sim.lua's
# and before modules\Situations.lua's (below), so a reload is known before its first
# SituationChanged reaches the window; its NS.STAND_UP step runs before modules\Situations.lua's too.
# Publishes NS.Session, the session start and the This instance mark kept per character
# (feedback-15 spec §0); appends its handler to NS.addon (core\DropWatcher.lua, above) at load.
# NS.Compat is read at call time.
modules\Session.lua
# LOAD-BEARING: appends its PLAYER_ENTERING_WORLD, ZONE_CHANGED_NEW_AREA, GROUP_ROSTER_UPDATE,
# CHALLENGE_MODE_START and CHALLENGE_MODE_COMPLETED rows to NS.FEATURE_EVENTS after modules\Sim.lua's
# (and modules\Session.lua's PLAYER_ENTERING_WORLD row) and before every module below that shares those events, so the situation handler runs before theirs
# and they read a fresh situation; its NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after
# those of the modules above. Publishes NS.Situations, the situation classifier and its edge; appends
# its handler to NS.addon (core\DropWatcher.lua, above) at load, and reads NS.Constants, NS.State,
# NS.MSG and NS.C (defaults\, above) at load.
modules\Situations.lua
# Conventional: publishes NS.TradeRules, the pure trade estimator; read by the feed at call time
# only, and itself reads NS.Constants (core\, above) and NS.C (defaults\, above) at load.
modules\TradeRules.lua
# Conventional: publishes NS.FeedFilter, the feed's pure filters of design spec §6.3 (peeled out of
# modules\LootFeed.lua); read by the feed at call time only, and itself reads NS.Constants (core\,
# above) at load.
modules\FeedFilter.lua
# Conventional: publishes NS.FeedRecords, the feed's pure record logic (the dedupe match, the link a
# merge keeps, the encounter and run in force, the groups, a test drop's record, the bag item's
# overlay; peeled out of modules\LootFeed.lua); read by the feed at call time only. NS.ItemRead
# (core\, above) is read at call time.
modules\FeedRecords.lua
# Conventional: publishes NS.FeedCounts, the feed's hidden and refused receipts counted by reason
# (peeled out of modules\LootFeed.lua); read by the feed and the diagnostics at call time only.
modules\FeedCounts.lua
# Conventional: publishes NS.Messaging, the pure messaging core (templates, the one-ask guard and
# the send queue); read by the messaging edge at call time only, and itself reads NS.Constants
# (core\, above) at load.
modules\Messaging.lua
# LOAD-BEARING: its NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of the modules
# above. Publishes NS.Restrictions, the restriction tracker; appends its
# ADDON_RESTRICTION_STATE_CHANGED row (no other file handles it) to NS.FEATURE_EVENTS and its handler
# to NS.addon (core\DropWatcher.lua, above) at load, and reads NS.State at load.
# core\DropWatcher.lua's combat edges and the feature modules read it at call time.
modules\Restrictions.lua
# LOAD-BEARING: appends its GROUP_ROSTER_UPDATE row to NS.FEATURE_EVENTS after modules\Sim.lua's and
# modules\Situations.lua's (above), so the situation handler runs first and the roster handler
# second; a module declaring the event below it hears it after the roster is fresh. Its NS.STAND_DOWN
# / NS.STAND_UP steps run in TOC order, after those of the modules above. Publishes NS.Roster, the
# group's members and the name resolver; appends its handler to NS.addon (core\DropWatcher.lua,
# above) and reads NS.State at load.
modules\Roster.lua
# LOAD-BEARING: adds its Grow to NS.Roster's change sinks at load, so it sits below
# modules\Roster.lua, which publishes NS.Roster (above it the add is skipped, silently). Publishes
# NS.GroupRoster, each group's roster snapshot and its tooltip line; reads NS.L at load. NS.Compat,
# NS.LootFeed, NS.History and NS.Window (below) are read at call time.
modules\GroupRoster.lua
# Conventional: publishes NS.GroupPlace, where a group dropped (its instance and difficulty name) and
# who saw it, for the headers (feedback-3 spec §4); reads NS.Constants and NS.L at load. NS.Compat
# and NS.GroupRoster (above) are read at call time; modules\LootFeed.lua (below) stamps through it.
modules\GroupPlace.lua
# LOAD-BEARING: publishes NS.CharFilter, the Character dropdown's recorder, rows and predicate
# (feedback-2 spec §4), which modules\WindowFilterBar.lua (below) takes as a load-time upvalue;
# reads NS.L at load. NS.Compat is read at call time.
modules\CharFilter.lua
# LOAD-BEARING: its NS.STAND_DOWN step runs in TOC order, after those of the modules above. Publishes
# NS.ItemFacts, the cached item facts; appends its TRANSMOG_COLLECTION_UPDATED row (no other file
# handles it) to NS.FEATURE_EVENTS and its handler to NS.addon (core\DropWatcher.lua, above) at load,
# and reads NS.Constants and NS.State at load. NS.Compat, NS.Item and NS.Debug are read at call time.
modules\ItemFacts.lua
# LOAD-BEARING: appends its rows to NS.FEATURE_EVENTS where other files share the event:
# BAG_UPDATE_DELAYED before modules\TradeTimer.lua's, and PLAYER_REGEN_ENABLED after
# core\DropWatcher.lua's and before modules\Inspect.lua's and modules\Toast.lua's; its NS.STAND_DOWN
# / NS.STAND_UP steps run in TOC order, after those of the modules above. Publishes NS.Gear, the
# player's gear snapshot and candidate; appends its handlers to NS.addon (core\DropWatcher.lua,
# above) and reads NS.Constants, NS.ClassData and NS.State at load. NS.Compat, NS.ItemFacts and
# NS.Evaluate (above) are read at call time.
modules\Gear.lua
# Conventional: publishes NS.LootParser, the CHAT_MSG_LOOT reader; appends its row to
# NS.FEATURE_EVENTS and its handler to NS.addon (core\DropWatcher.lua, above) at load, and takes
# NS.Perf (core\PerfSetup.lua, above) as a load-time upvalue. NS.Compat and NS.Roster are read at
# call time; the feed (DW-27) adds its sink at load.
modules\LootParser.lua
# LOAD-BEARING: appends its rows to NS.FEATURE_EVENTS after other files' on shared events:
# GROUP_ROSTER_UPDATE and PLAYER_ENTERING_WORLD after modules\Roster.lua's and
# modules\Situations.lua's, so the roster is fresh; both PLAYER_REGEN edges after
# core\DropWatcher.lua's (PLAYER_REGEN_ENABLED after modules\Gear.lua's too); its NS.STAND_DOWN step
# runs in TOC order, after those of the modules above. Publishes NS.Inspect, the inspect broker;
# appends its handlers to NS.addon, hooks NotifyInspect through NS.Compat and takes NS.Perf as a
# load-time upvalue at load. NS.Roster, NS.ItemFacts, NS.Restrictions and NS.Situations (above) are
# read at call time.
modules\Inspect.lua
# LOAD-BEARING: adds its sink to NS.LootParser (modules\LootParser.lua, above) at load, and appends
# its rows to NS.FEATURE_EVENTS after other files' on shared events: CHALLENGE_MODE_START and
# CHALLENGE_MODE_COMPLETED after modules\Situations.lua's, so the situation is fresh, and
# ENCOUNTER_START / ENCOUNTER_END before modules\Asks.lua's and modules\AutoAsk.lua's (below); its
# NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of the modules above. Publishes
# NS.LootFeed, the feed orchestrator; registers its InspectDone, GearChanged and TradeTimerTick
# receivers on a NS.Bus target and takes NS.Perf as a load-time upvalue at load. Every module above,
# and NS.TradeTimer and NS.Window (below), are read at call time.
modules\LootFeed.lua
# LOAD-BEARING: appends its BAG_UPDATE_DELAYED row to NS.FEATURE_EVENTS after modules\Gear.lua's, so
# the gear handler runs first; its NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of
# the modules above. Publishes NS.TradeTimer, the own-item trade countdown; appends its LOOT_CLOSED
# row and its handler to NS.addon, registers its DropAdded receiver on a NS.Bus target and takes
# NS.Perf as a load-time upvalue at load. NS.LootFeed (above) and NS.Window (below) are read at call
# time.
modules\TradeTimer.lua
# Conventional: publishes NS.TradeHelper, the click-driven trade actions; builds its reason texts
# from NS.L at load. NS.Restrictions, NS.Roster and NS.TradeTimer (above) are read at call time.
modules\TradeHelper.lua
# LOAD-BEARING: publishes NS.Asks, the messaging edge. At load it takes NS.Messaging (above),
# NS.Constants (C.MESSAGE_FLUSH_INTERVAL), NS.L and NS.State, registers its RestrictionChanged
# receiver on a NS.Bus target, and appends its rows to NS.FEATURE_EVENTS, NS.STAND_DOWN and
# NS.STAND_UP and its handlers to NS.addon (core\DropWatcher.lua), all above. Its shared-event rows
# rely on this position: GROUP_ROSTER_UPDATE after modules\Roster.lua's (the roster is fresh for
# a left-group cancel), ENCOUNTER_END after modules\LootFeed.lua's, and CHALLENGE_MODE_COMPLETED
# after modules\Situations.lua's and modules\LootFeed.lua's. NS.Restrictions, NS.Roster and
# NS.LootFeed (above) are read at call time.
modules\Asks.lua
# LOAD-BEARING: its NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of the modules
# above. Publishes NS.History, the account-wide log (kept by days) of the feed's drops and their
# outcomes; appends its TRADE_* rows (no other file handles them) to NS.FEATURE_EVENTS and its
# handlers to NS.addon (core\DropWatcher.lua) at load, and registers its DropAdded, DropUpdated and
# AskStateChanged receivers on a NS.Bus target at load. NS.LootFeed, NS.Compat and NS.Setting
# (settings\Schema.lua, below) are read at call time.
modules\History.lua
# LOAD-BEARING: appends its PLAYER_ENTERING_WORLD row to NS.FEATURE_EVENTS after modules\Sim.lua's,
# modules\Situations.lua's and modules\Inspect.lua's (above) and before modules\AutoAsk.lua's
# (below); its NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of the modules above.
# Publishes NS.HistoryRetention (Keep history for: the window, the confirmation, the login prune);
# appends its handler to NS.addon (core\DropWatcher.lua) at load. NS.History (above), NS.Setting and
# NS.SchemaRuntime (settings\Schema.lua, below) are read at call time; settings\SchemaRows.lua
# (below) reads its Choices at load.
modules\HistoryRetention.lua
# LOAD-BEARING: appends its PLAYER_ENTERING_WORLD row to NS.FEATURE_EVENTS after
# modules\Situations.lua's and modules\HistoryRetention.lua's (above) and before modules\AutoAsk.lua's
# (below), so a reload's feed is rebuilt on a fresh situation. Publishes NS.FeedRestore, the Drops
# tab rebuilt from this session's History entries after a reload (feedback-15 spec §0); appends its
# handler to NS.addon (core\DropWatcher.lua) at load. NS.History, NS.LootFeed, NS.Roster,
# NS.GroupRoster and NS.CharFilter (above) are read at call time.
modules\FeedRestore.lua
# LOAD-BEARING: its NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of the modules
# above. Publishes NS.Window; reads NS.Perf, NS.L, NS.Constants, NS.Bus and NS.MSG (core\ and
# locales\, above) at load, and registers its bus receivers (RestrictionChanged, AskStateChanged,
# SituationChanged, DropAdded, DropUpdated, InspectDone, TradeTimerTick, TradeTimerExpiring) on its
# own NS.Bus target. Every engine module above, and NS.WindowTitleBar / NS.WindowFilterBar /
# NS.WindowFooter / NS.OfferPanel (below), are read at call time: the frame is built on the first
# show.
modules\Window.lua
# Conventional: publishes NS.WindowTitleBar (the title bar, the badge's words and the window's flat
# and icon buttons); reads NS.Constants and NS.L at load, and NS.Window (above), NS.Asks and the
# host handlers at call time.
modules\WindowTitleBar.lua
# LOAD-BEARING: adds a visibility listener to NS.Window (modules\Window.lua, above) at load, and
# appends its CHALLENGE_MODE_START / _COMPLETED rows to NS.FEATURE_EVENTS after
# modules\Situations.lua's and modules\LootFeed.lua's, so the situation is fresh; its NS.STAND_DOWN /
# NS.STAND_UP steps run in TOC order, after those of the modules above. Publishes NS.WindowCompact
# (compact mode's switch: the layout in force, each layout's geometry, the run override); reads
# NS.Constants and registers its SituationChanged receiver on its own NS.Bus target at load.
# NS.Setting, NS.WindowFilterBar, NS.Situations, NS.LootFeed and NS.State are read at call time.
modules\WindowCompact.lua
# LOAD-BEARING: takes NS.CharFilter (modules\CharFilter.lua, above) as a load-time upvalue. Publishes
# NS.WindowFilterBar (the filter bar, each tab's filter state and the row predicates); reads
# NS.Constants, NS.L, NS.State and NS.C (defaults\, above) at load, and NS.Window (above) at call
# time.
modules\WindowFilterBar.lua
# Conventional: publishes NS.WindowFooter (the footer's composer and reads); reads NS.Constants and
# NS.L at load, and NS.Window, NS.WindowFilterBar (above) and the engine modules at call time.
modules\WindowFooter.lua
# Conventional: publishes NS.WindowCells, the drop tables' pure cell composers (each column's text,
# glyph, tone and reason tooltip); reads NS.Constants and NS.L at load.
modules\WindowCells.lua
# LOAD-BEARING: reads NS.WindowCells (modules\WindowCells.lua, above) at load, and sits above
# modules\TipGrid.lua, modules\MineCells.lua, modules\SideCells.lua, modules\DetailCells.lua and
# modules\OfferPanel.lua (which take it at load), modules\WindowGroup.lua and
# modules\WindowHistory.lua (whose column tooltips call it at load). Publishes NS.TipMarks, what text
# in the default face draws for a verdict mark or an arrow (an inline texture, never a font glyph:
# tooltips, the detail card, the Offer panel) and a name's quality or class color (the toast), a
# tooltip's non-wrapping line and its gear grid's rows; reads NS.Constants and NS.L at load, and
# NS.Icon, NS.Compat and NS.GroupRoster at call time.
modules\TipMarks.lua
# LOAD-BEARING: reads NS.TipMarks (modules\TipMarks.lua, above) at load. Publishes NS.TipGrid, the
# frame edge that paints a tooltip's grid (feedback-7 spec §3: columns on a pooled child frame of
# GameTooltip); reads NS.Constants at load. modules\Window.lua (above) calls it at hover time.
modules\TipGrid.lua
# Conventional: publishes NS.WindowRows, the drop tables' row height and text size (the pure
# resolution and the font edge the two tabs share); reads NS.Constants at load and NS.Setting at
# call time.
modules\WindowRows.lua
# LOAD-BEARING: takes NS.WindowCells and NS.TipMarks (modules\, above) at load. Publishes
# NS.MineCells, the pure composers for your own drops and the Offer panel (the countdown, the
# candidates and their pills, the buttons, the strip's summary, Post my tradeables' lines, the dock,
# and your own drop's cells on Drops); takes NS.Constants and NS.L at load.
modules\MineCells.lua
# LOAD-BEARING: takes NS.WindowCells, NS.TipMarks and NS.MineCells (modules\, above) at load.
# Publishes NS.SideCells, the drop tables' pure Me and Them cells (the worn gear and the verdict in
# one cell; feedback-6 spec §1); takes NS.L at load.
modules\SideCells.lua
# LOAD-BEARING: takes NS.MineCells (modules\MineCells.lua, above) at load. Publishes NS.WindowOwn,
# your own drops on Drops (the session's reveal state, the Offer and Announce tone states, the
# message buttons' look, the own-drop cell reads and the Ask-or-Offer click); takes NS.State at load.
# NS.WindowCells, the asks, the history, the Offer panel and the host handlers are read at call time.
modules\WindowOwn.lua
# Conventional: publishes NS.RowTooltip, the one placement of a table row's tooltips (the row's top
# right, like Ka0s Loot History; feedback-3 spec §2, DW-B2); takes NS.Constants at load. NS.MineCells
# (above) is read at call time; NS.Window (above) and the tabs' bodies (below) call it at hover time.
modules\RowTooltip.lua
# LOAD-BEARING: publishes NS.WindowGroup and registers the Drops body through
# Window.RegisterTab (modules\Window.lua, above) at load; takes NS.WindowCells, NS.SideCells and
# NS.TipMarks (above, its column tooltips call TipMarks.Mark), NS.Constants, NS.L and NS.State at load. The feed, the inspect broker, the asks, the pool, the detail card
# (modules\DetailCard.lua, below) and the host handlers (core\DropWatcher.lua) are read at call time,
# when the tab is built and repainted.
modules\WindowGroup.lua
# Conventional: publishes NS.DropsStrip, the Drops tab's summary strip (your tradeable drops, the
# next expiry, Post my tradeables and Scan group, Post shortened in the compact layout) and its empty
# state (Preview with test data and Scan group); takes NS.Constants and NS.L at load. NS.Window,
# NS.WindowTitleBar, NS.WindowFooter, NS.MineCells, the feed and the host handlers are read at call
# time, when NS.WindowGroup builds and repaints the tab.
modules\DropsStrip.lua
# LOAD-BEARING: takes NS.WindowCells, NS.TipMarks and NS.MineCells (modules\, above) at load.
# Publishes NS.DetailCells, the detail card's pure composers (chips, both comparisons, the trade box,
# the actions); takes NS.Constants and NS.L at load.
modules\DetailCells.lua
# LOAD-BEARING: takes NS.DetailCells (modules\DetailCells.lua, above) at load. Publishes
# NS.DetailCard, the detail card's frame edge and the Edit message box; takes NS.Constants and NS.L
# at load. NS.WindowGroup builds it (above, at call time); NS.Window, NS.TipMarks (a chip's estimated
# width), the engine modules and the host handlers are read at call time.
modules\DetailCard.lua
# LOAD-BEARING: takes NS.MineCells, NS.SideCells and NS.TipMarks (modules\, above; the Their eq
# column's tooltip calls TipMarks.Mark) at load. Publishes NS.OfferPanel, the "Who could use this?"
# panel; takes NS.Constants, NS.L and NS.State at load. NS.Window, NS.WindowGroup (SideCell,
# PaintSide, ClassTone), NS.WindowOwn, NS.Inspect, the feed, the asks and the host handlers are read
# at call time: it is built on its first Open.
modules\OfferPanel.lua
# LOAD-BEARING: publishes NS.WindowHistory and registers the History body through Window.RegisterTab
# (modules\Window.lua, above) at load, and its HistoryChanged receiver on a NS.Bus target; takes
# NS.WindowCells, NS.SideCells, NS.TipMarks (its column tooltips call TipMarks.Mark), NS.Constants,
# NS.L and NS.State at load. NS.History, NS.Gear (your class, for the Me tooltip's `You`),
# NS.WindowGroup's item button and layout, NS.WindowFilterBar and NS.WindowFooter (above) are read at call time.
modules\WindowHistory.lua
# LOAD-BEARING: takes NS.WindowCells, NS.MineCells and NS.SideCells (modules\, above) at load.
# Publishes NS.CompactCards, compact mode's pure card composers (each card's three lines, tones and
# tooltips for both tabs, and the header's short form); takes NS.L at load. NS.WindowHistory (above)
# is read at call time.
modules\CompactCards.lua
# Conventional: publishes NS.CompactGroup, the Drops tab's compact layout (pooled three-line
# cards, one-line headers, the stacked detail card); takes NS.Constants at load. NS.WindowGroup,
# NS.CompactCards, NS.DetailCard, NS.WindowRows and the host handlers are read at call time: WindowGroup's
# refresh hands it the entries.
modules\CompactGroup.lua
# Conventional: publishes NS.CompactHistory, the History tab's compact layout (three-line cards
# with the outcome, the row menu on a right-click); takes NS.Constants and NS.L at load.
# NS.CompactGroup's kit, NS.CompactCards and NS.WindowHistory are read at call time.
modules\CompactHistory.lua
# LOAD-BEARING: adds a visibility listener to NS.Window (modules\Window.lua, above) at load.
# Publishes NS.CompactChrome, the window's chrome in the compact layout (the short title and words,
# the badge, the icon Scan group, the short tabs, the one-row filter bar and its Filters panel, the
# strip and the one-line footer); takes NS.Constants and NS.L at load. Everything else is read at
# call time.
modules\CompactChrome.lua
# Conventional: publishes NS.TestData, test mode's pure sample data (the drops and the History
# groups over pool items); takes NS.Constants and NS.L at load. NS.Item is read at call time.
modules\TestData.lua
# LOAD-BEARING: takes NS.TestData (modules\TestData.lua, above) at load; its NS.STAND_DOWN step runs
# in TOC order, after those of the modules above. Publishes NS.TestMode, test mode's edge (the item
# pool, populate and clear) and the hooks the drop tables read (InspectOf, AskState) and the History
# log (HistoryLog); takes NS.L and NS.State at load. NS.LootFeed, NS.SimPool (below), NS.ItemFacts,
# NS.ItemRead, NS.WindowFilterBar and NS.Inspect are read at call time; core\DropWatcher.lua's
# NS.SetTestMode calls Populate and Clear.
modules\TestMode.lua
# LOAD-BEARING: adds its removal sink to NS.LootFeed (modules\LootFeed.lua, above) at load, and
# appends both PLAYER_REGEN rows to NS.FEATURE_EVENTS after core\DropWatcher.lua's and
# modules\Inspect.lua's (PLAYER_REGEN_ENABLED after modules\Gear.lua's too); its NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of
# the modules above. Publishes NS.Toast, the opt-in upgrade toast; appends its handlers to NS.addon
# and registers its DropAdded, DropUpdated and AskStateChanged receivers on a NS.Bus target at load.
# NS.LootFeed, NS.Asks, NS.Window, NS.WindowGroup, NS.WindowCells, NS.SideCells (the verdicts),
# NS.WindowRows (the item level's mark), NS.TipMarks (the quality and class colors), NS.Setting and
# the host handlers are read at call time: the frame is built on the first toast.
modules\Toast.lua
# LOAD-BEARING: appends its ENCOUNTER_START, ENCOUNTER_END, GROUP_ROSTER_UPDATE,
# PLAYER_ENTERING_WORLD and ZONE_CHANGED_NEW_AREA rows to NS.FEATURE_EVENTS after every other file's
# on those events (modules\Sim.lua's, modules\Session.lua's, modules\Situations.lua's,
# modules\Roster.lua's, modules\Inspect.lua's, modules\LootFeed.lua's, modules\Asks.lua's,
# modules\HistoryRetention.lua's and modules\FeedRestore.lua's), so its handler runs last; its
# NS.STAND_DOWN / NS.STAND_UP steps run in TOC order, after those of the modules above. Publishes
# NS.AutoAsk, the opt-in auto-ask; appends its handlers to NS.addon and registers its DropAdded,
# DropUpdated, AskStateChanged and HistoryChanged receivers on a NS.Bus target at load. NS.LootFeed,
# NS.Toast's qualifier, NS.Asks, NS.Roster, NS.Restrictions, NS.History, NS.Setting and
# NS.AskTargetOf are read at call time.
modules\AutoAsk.lua
# Conventional: publishes NS.SimRoster, the simulator's invented group and its gear (pure, but for
# Create); reads NS.Constants and NS.ClassData at load. NS.Sim, NS.SimPool (below) and NS.Compat are
# read at call time.
modules\SimRoster.lua
# Conventional: publishes NS.SimPool, the item pool from the Encounter Journal (the simulator's and,
# through BuildInto, test mode's: modules\TestMode.lua reads it at call time); appends
# its EJ_LOOT_DATA_RECIEVED row to NS.FEATURE_EVENTS and its handler to NS.addon (core\DropWatcher.lua)
# at load, and reads NS.Constants, NS.ClassData, NS.State and NS.L at load. NS.Sim, NS.Gear and
# NS.Compat are read at call time.
modules\SimPool.lua
# Conventional: publishes NS.SimWorld, the simulated world's client answers, and registers them as
# providers on NS.Sim (core\SimSeam.lua) at load; reads NS.Constants and NS.L at load. NS.SimRoster,
# NS.SimPool, NS.SimEvents (below) and NS.Compat are read at call time.
modules\SimWorld.lua
# LOAD-BEARING: adds its cleanup step through Sim.AddCleanup, which modules\Sim.lua (above) defines,
# at load; the steps run in that order, so modules\SimScenario.lua's (below) runs after it. Publishes
# NS.SimEvents, the simulator's event drivers. NS.SimWorld, NS.SimPool, NS.Roster, NS.LootFeed and
# NS.Compat are read at call time.
modules\SimEvents.lua
# Conventional: publishes NS.SimReport, where a simulated loot burst's drops went; reads NS.L at
# load. NS.State, NS.SimEvents (above), NS.LootFeed and NS.WindowCells are read at call time.
modules\SimReport.lua
# LOAD-BEARING: adds its cleanup step through Sim.AddCleanup, which modules\Sim.lua (above) defines,
# at load, after modules\SimEvents.lua's. Publishes NS.SimScenario, the simulator's scenarios and
# timeline; reads NS.L at load. NS.Sim, NS.SimPool, NS.SimRoster, NS.SimEvents, NS.SimReport and
# NS.Window are read at call time.
modules\SimScenario.lua
# LOAD-BEARING: adds its repaint to NS.SimScenario's listeners (modules\SimScenario.lua, above) at
# load; its NS.STAND_DOWN step runs in TOC order, after those of the modules above. Publishes
# NS.SimPanel, the simulation step panel; reads NS.L and NS.Constants at load. NS.Sim,
# NS.SimScenario, NS.SimVerbs (settings\, below), NS.SimEvents, NS.Window, NS.MineCells and
# NS.WindowFooter are read at call time: the frame is built on the first Show.
modules\SimPanel.lua
# Conventional: core\DebugLogSetup.lua's descriptor reads NS.Diagnostics at RUN time.
modules\Diagnostics.lua

# Settings (last -- depend on everything else being initialized)
# LOAD-BEARING: publishes Settings.SchemaLib, which settings\Schema.lua calls :New on at file scope.
settings\SchemaSetup.lua
# LOAD-BEARING: publishes Settings.Schema and NS.SchemaRuntime; settings\OptionsSetup.lua,
# settings\Panel.lua and settings\Slash.lua read NS.SchemaRuntime at load.
settings\Schema.lua
# LOAD-BEARING: appends every hand-written row to NS.SchemaRuntime at file scope; reads NS.C,
# NS.Constants, Settings.StampClosureRows and NS.QualityGate, NS.WindowFooter, NS.WindowGroup
# (modules\, above) at load.
settings\SchemaRows.lua
# LOAD-BEARING: publishes the LibKa0s-Options instance as Settings.Helpers; settings\Panel.lua calls
# Helpers.MasterControls at file scope.
settings\OptionsSetup.lua
# LOAD-BEARING: reads NS.C, Settings.Helpers and NS.SchemaRuntime.AddRows at file scope.
settings\Panel.lua
# LOAD-BEARING: publishes Settings.Editors (the pure halves of the pages' own editors), which
# settings\PageEditors.lua takes at load; reads NS.L, NS.Constants and NS.ClassData at load, and
# NS.Evaluate and NS.Messaging (modules\, above) at call time.
settings\Editors.lua
# LOAD-BEARING: publishes Settings.PageEditors, which settings\Pages.lua takes at load and
# settings\Panel.lua (above) reaches at render time (When to show's table); takes Settings.Editors
# (above) at load and the engine modules at call time.
settings\PageEditors.lua
# LOAD-BEARING: registers the Feed, Comparison, Trade, Messages and Window pages after General's
# (settings\Panel.lua, above) and before Profiles' (below), the order the settings list shows.
settings\Pages.lua
# Conventional: publishes NS.SlashVerbs, the slash-only feature verbs' handlers, which
# settings\Slash.lua's NS.COMMANDS calls at RUN time; reads NS.L at load and every module above
# at call time.
settings\SlashVerbs.lua
# Conventional: publishes NS.SimVerbs, `/dw sim`'s handler, which settings\Slash.lua's NS.COMMANDS
# calls at RUN time; reads NS.L at load and the simulator's modules (above) at call time.
settings\SimVerbs.lua
# LOAD-BEARING: captures NS.SchemaRuntime.Get/Set/FindRow/ApplyDefault at load.
settings\Slash.lua
# LAST, so its RegisterOptionsPage call queues behind every other page's (options-ui-§3).
settings\Profiles.lua
