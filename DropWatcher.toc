## Interface: 120100
## Title: Ka0s Drop Watcher
## Notes: Watches your group's loot, shows who each drop is an upgrade for and whether it can be traded, and asks for it politely in one click.
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\DropWatcher\media\logos\dropwatcher.logo.128.tga
## SavedVariables: DropWatcherDB, DropWatcherPerfDB
## OptionalDeps: Pawn, CanIMogIt, Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Group
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
# X-Curse-Project-ID: not published on CurseForge yet

# Libraries (must load first) -- vendored in libs/, .xml where the lib ships one, else .lua
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
# LOAD-BEARING: AceConfigDialog-3.0 resolves AceGUI-3.0 with a non-silent LibStub at file load, so
# AceConfig-3.0.xml sits below AceGUI-3.0.xml. AceDBOptions resolves nothing at load.
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
# Conventional: LibKa0s-Launcher-1.0 resolves both at Register time; LibDBIcon needs the two above it.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\lib.xml
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml

# Locales
# LOAD-BEARING: publishes NS.L, which every file below reads at load.
locales\enUS.lua

# Core -- dependency-correct order (layout-§1)
# LOAD-BEARING: publishes NS.name, NS.BRAND, NS.PREFIX and NS.SLASH, read at load below.
core\Namespace.lua
# LOAD-BEARING: publishes NS.Print / NS.Util.print and NS.LIBKA0S_MISSING, read at load below.
core\CoreSetup.lua
# Conventional: NS.Compat (every version-variant client call and the secret guards) is read inside
# functions only; it needs LibStub alone at load.
core\Compat.lua
# LOAD-BEARING: publishes NS.MediaFont, which core\Constants.lua resolves FONT_MONO from at load.
core\MediaSetup.lua
# LOAD-BEARING: publishes the NS.Constants id tables, which core\ClassData.lua reads at load; FONT_MONO
# is resolved from the seam above.
core\Constants.lua
# Conventional: data plus pure lookups (NS.ClassData), read by the feature modules at call time.
core\ClassData.lua
# Conventional: session-only state (NS.State), read by everything below at call time.
core\State.lua
# Conventional: NS.Meta / NS.Version are read inside functions only.
core\EnvSetup.lua
# Conventional: NS.Pool is read inside functions only.
core\PoolSetup.lua
# Conventional: NS.Item is read inside functions only.
core\ItemSetup.lua
# Conventional: NS.MakeDropdown / NS.CloseMenu are read inside functions only (the window's
# filter bar and footer, built on the first show).
core\WidgetsSetup.lua
# LOAD-BEARING: publishes NS.MSG (the message catalog) and NS.Bus; every file that names a message
# takes NS.MSG at load.
core\Bus.lua
# LOAD-BEARING relative to core\PerfSetup.lua only, which hands NS.Lifecycle to lib:New at load.
core\LifecycleSetup.lua
# LOAD-BEARING: lib:New reads NS.Lifecycle (above) at load, and modules\Window.lua takes
# `local Perf = NS.Perf` as a load-time upvalue (below).
core\PerfSetup.lua
# LOAD-BEARING: the lib:New descriptor reads NS.Constants.FONT_MONO (core\Constants.lua, above) at
# load; publishes NS.Debug before any call site runs.
core\DebugLogSetup.lua
# LOAD-BEARING: promotes NS to the AceAddon object (NS.addon) and reclaims NS.Print; modules\ and
# settings\ read NS.addon at load.
core\DropWatcher.lua
# Conventional: NS:RunMigrations is called from OnInitialize.
core\Database.lua
# Conventional: the launcher is built here and registered from OnEnable.
core\LauncherSetup.lua

# Defaults
# LOAD-BEARING: publishes NS.C, which settings\Schema.lua, settings\SchemaRows.lua and settings\Panel.lua
# take at load, and so do modules\QualityGate.lua, modules\Situations.lua, modules\TradeRules.lua and
# modules\WindowFilterBar.lua (their defaults, as file-scope upvalues); modules\Messaging.lua,
# modules\TradeTimer.lua and modules\MineCells.lua read it at call time. It stays above every module.
defaults\Profile.lua

# Modules
# Conventional: publishes NS.Evaluate, the pure verdict kernel; read by the feature modules at call
# time only, and itself reads NS.Constants and NS.ClassData (core\, above) at load.
modules\Evaluate.lua
# Conventional: publishes NS.Scoring, the scorers behind the kernel's opts.scorer (Pawn, your weights,
# none); read by the feed and the diagnostics at call time only, and itself reads NS.ClassData
# (core\, above) at load. NS.Compat's Pawn seam, NS.Setting and NS.DebugOnce are read at call time.
modules\Scoring.lua
# Conventional: publishes NS.QualityGate, the pure minimum-quality gate; read by the feed at call
# time only, and itself reads NS.Constants (core\, above), NS.L (locales\, above) and NS.C
# (defaults\, above) at load.
modules\QualityGate.lua
# Conventional: publishes NS.Situations, the situation classifier and its edge; appends its rows
# to NS.FEATURE_EVENTS, NS.STAND_DOWN and NS.STAND_UP and its handler to NS.addon
# (core\DropWatcher.lua, above) at load, and reads NS.Constants, NS.State, NS.MSG and NS.C
# (defaults\, above) at load.
modules\Situations.lua
# Conventional: publishes NS.TradeRules, the pure trade estimator; read by the feed at call time
# only, and itself reads NS.Constants (core\, above) and NS.C (defaults\, above) at load.
modules\TradeRules.lua
# Conventional: publishes NS.Messaging, the pure messaging core (templates, the one-ask guard and
# the send queue); read by the messaging edge at call time only, and itself reads NS.Constants
# (core\, above) at load.
modules\Messaging.lua
# Conventional: publishes NS.Restrictions, the restriction tracker; appends its row to
# NS.FEATURE_EVENTS, NS.STAND_DOWN and NS.STAND_UP and its handler to NS.addon
# (core\DropWatcher.lua, above) at load, and reads NS.State at load. core\DropWatcher.lua's combat
# edges and the feature modules read it at call time.
modules\Restrictions.lua
# Conventional: publishes NS.Roster, the group's members and the name resolver; appends its row to
# NS.FEATURE_EVENTS (GROUP_ROSTER_UPDATE, shared with modules\Situations.lua above, so its handler
# runs second), NS.STAND_DOWN and NS.STAND_UP and its handler to NS.addon (core\DropWatcher.lua,
# above) at load, and reads NS.State at load. A module declaring the event below it hears it after
# the roster is fresh.
modules\Roster.lua
# Conventional: publishes NS.ItemFacts, the cached item facts; appends its row to NS.FEATURE_EVENTS
# and NS.STAND_DOWN and its handler to NS.addon (core\DropWatcher.lua, above) at load, and reads
# NS.Constants and NS.State at load. NS.Compat, NS.Item and NS.Debug are read at call time.
modules\ItemFacts.lua
# Conventional: publishes NS.Gear, the player's gear snapshot and candidate; appends its rows to
# NS.FEATURE_EVENTS, NS.STAND_DOWN and NS.STAND_UP and its handlers to NS.addon
# (core\DropWatcher.lua, above) at load, and reads NS.Constants, NS.ClassData and NS.State at load.
# NS.Compat, NS.ItemFacts and NS.Evaluate (above) are read at call time.
modules\Gear.lua
# Conventional: publishes NS.LootParser, the CHAT_MSG_LOOT reader; appends its row to
# NS.FEATURE_EVENTS and its handler to NS.addon (core\DropWatcher.lua, above) at load, and takes
# NS.Perf (core\PerfSetup.lua, above) as a load-time upvalue. NS.Compat and NS.Roster are read at
# call time; the feed (DW-27) adds its sink at load.
modules\LootParser.lua
# Conventional: publishes NS.Inspect, the inspect broker; appends its rows to NS.FEATURE_EVENTS
# (GROUP_ROSTER_UPDATE and PLAYER_ENTERING_WORLD after modules\Roster.lua's and
# modules\Situations.lua's, so the roster is fresh; both PLAYER_REGEN edges after
# core\DropWatcher.lua's) and NS.STAND_DOWN and its handlers to NS.addon at load, hooks
# NotifyInspect through NS.Compat at load, and takes NS.Perf as a load-time upvalue. NS.Roster,
# NS.ItemFacts, NS.Restrictions and NS.Situations (above) are read at call time.
modules\Inspect.lua
# Conventional: publishes NS.LootFeed, the feed orchestrator; adds its sink to NS.LootParser and
# appends its rows to NS.FEATURE_EVENTS (CHALLENGE_MODE_START and CHALLENGE_MODE_COMPLETED after
# modules\Situations.lua's, so the situation is fresh) and NS.STAND_DOWN / NS.STAND_UP at load, and
# registers its InspectDone, GearChanged and TradeTimerTick receivers on a NS.Bus target at load;
# takes NS.Perf as a load-time upvalue. Every module above, and NS.TradeTimer and NS.Window (below),
# are read at call time.
modules\LootFeed.lua
# Conventional: publishes NS.TradeTimer, the own-item trade countdown; appends its rows to
# NS.FEATURE_EVENTS (BAG_UPDATE_DELAYED after modules\Gear.lua's) and NS.STAND_DOWN / NS.STAND_UP
# and its handler to NS.addon at load, registers its DropAdded receiver on a NS.Bus target at load,
# and takes NS.Perf as a load-time upvalue. NS.LootFeed (above) and NS.Window (below) are read at
# call time.
modules\TradeTimer.lua
# Conventional: publishes NS.TradeHelper, the click-driven trade actions; builds its reason texts
# from NS.L at load. NS.Restrictions, NS.Roster and NS.TradeTimer (above) are read at call time.
modules\TradeHelper.lua
# LOAD-BEARING: publishes NS.Asks, the messaging edge. At load it takes NS.Messaging (above),
# NS.Constants (C.MESSAGE_FLUSH_INTERVAL), NS.L and NS.State, registers its RestrictionChanged
# receiver on a NS.Bus target, and appends its rows to NS.FEATURE_EVENTS, NS.STAND_DOWN and
# NS.STAND_UP and its handlers to NS.addon (core\DropWatcher.lua), all above. Its shared-event rows
# rely on this position: GROUP_ROSTER_UPDATE after modules\Roster.lua's (the roster is fresh for
# a left-group cancel), ENCOUNTER_END after modules\LootFeed.lua's, and CHALLENGE_MODE_COMPLETED
# after modules\Situations.lua's and modules\LootFeed.lua's. NS.Restrictions, NS.Roster and
# NS.LootFeed (above) are read at call time.
modules\Asks.lua
# Conventional: publishes NS.History, the capped account-wide log of the feed's drops and their
# outcomes; appends its TRADE_* rows to NS.FEATURE_EVENTS and NS.STAND_DOWN / NS.STAND_UP and its
# handlers to NS.addon (core\DropWatcher.lua) at load, and registers its DropAdded, DropUpdated and
# AskStateChanged receivers on a NS.Bus target at load. NS.LootFeed, NS.Compat and NS.Setting
# (settings\Schema.lua, below) are read at call time.
modules\History.lua
# Conventional (vs. the settings files): publishes NS.Window; reads NS.Perf, NS.L, NS.Constants,
# NS.Bus and NS.MSG, and appends its rows to NS.STAND_DOWN / NS.STAND_UP, all published above, at
# load, and registers its bus receivers (RestrictionChanged, AskStateChanged, SituationChanged,
# DropAdded, DropUpdated, InspectDone, TradeTimerTick, TradeTimerExpiring) on its own NS.Bus
# target. Every engine module above, and NS.WindowTitleBar / NS.WindowFilterBar / NS.WindowFooter /
# NS.OfferPanel (below), are read at call time: the frame is built on the first show.
modules\Window.lua
# Conventional: publishes NS.WindowTitleBar (the title bar, the badge's words and the window's flat
# and icon buttons); reads NS.Constants and NS.L at load, and NS.Window (above), NS.Asks and the
# host handlers at call time.
modules\WindowTitleBar.lua
# Conventional: publishes NS.WindowFilterBar (the filter bar, each tab's filter state and the row
# predicates); reads NS.Constants, NS.L, NS.State and NS.C (defaults\, above) at load, and NS.Window
# (above) at call time.
modules\WindowFilterBar.lua
# Conventional: publishes NS.WindowFooter (the footer's composer and reads); reads NS.Constants and
# NS.L at load, and NS.Window, NS.WindowFilterBar (above) and the engine modules at call time.
modules\WindowFooter.lua
# Conventional: publishes NS.WindowCells, the drop tables' pure cell composers (each column's text,
# glyph, tone and reason tooltip); reads NS.Constants and NS.L at load.
modules\WindowCells.lua
# Conventional: publishes NS.MineCells, the My drops tab's and the Offer panel's pure composers (the
# countdown, the candidates and their pills, the buttons, Post my tradeables' lines, the dock);
# takes NS.WindowCells (above), NS.Constants and NS.L at load.
modules\MineCells.lua
# LOAD-BEARING: publishes NS.WindowGroup and registers the Group drops body through
# Window.RegisterTab (modules\Window.lua, above) at load; takes NS.WindowCells (above), NS.Constants,
# NS.L and NS.State at load. The feed, the inspect broker, the asks, the pool, the detail card
# (modules\DetailCard.lua, below) and the host handlers (core\DropWatcher.lua) are read at call time,
# when the tab is built and repainted.
modules\WindowGroup.lua
# Conventional: publishes NS.DetailCells, the detail card's pure composers (chips, both comparisons,
# the trade box, the actions); takes NS.WindowCells (above), NS.Constants and NS.L at load.
modules\DetailCells.lua
# Conventional: publishes NS.DetailCard, the detail card's frame edge and the Edit message box; takes
# NS.DetailCells (above), NS.Constants and NS.L at load. NS.WindowGroup builds it (above, at call
# time); NS.Window, the engine modules and the host handlers are read at call time.
modules\DetailCard.lua
# LOAD-BEARING: publishes NS.WindowMine and registers the My drops body through Window.RegisterTab
# (modules\Window.lua, above) at load; takes NS.MineCells (above), NS.Constants, NS.L and NS.State
# at load. NS.WindowGroup's item button and layout, the feed, the asks, the trade timer, the pool,
# the Offer panel (below) and the host handlers (core\DropWatcher.lua) are read at call time.
modules\WindowMine.lua
# Conventional: publishes NS.OfferPanel, the "Who could use this?" panel; takes NS.MineCells (above),
# NS.Constants, NS.L and NS.State at load. NS.Window, NS.WindowGroup, NS.WindowMine, the feed, the
# asks, the trade helper and the host handlers are read at call time: it is built on its first Open.
modules\OfferPanel.lua
# LOAD-BEARING: publishes NS.WindowHistory and registers the History body through Window.RegisterTab
# (modules\Window.lua, above) at load, and its HistoryChanged receiver on a NS.Bus target; takes
# NS.WindowCells, NS.Constants, NS.L and NS.State at load. NS.History, NS.WindowGroup's item button
# and layout, NS.WindowFilterBar and NS.WindowFooter (above) are read at call time.
modules\WindowHistory.lua
# Conventional: publishes NS.TestMode, test mode's placeholder drops and the hooks the drop tables
# read (InspectOf, AskState); appends its row to NS.STAND_DOWN at load and reads NS.Constants and
# NS.L at load. NS.LootFeed, NS.WindowFilterBar, NS.Inspect (above) are read at call time;
# core\DropWatcher.lua's NS.SetTestMode calls Populate and Clear.
modules\TestMode.lua
# Conventional: publishes NS.Toast, the opt-in upgrade toast; appends its PLAYER_REGEN rows (after
# core\DropWatcher.lua's and modules\Inspect.lua's) to NS.FEATURE_EVENTS and its STAND_DOWN /
# STAND_UP steps and handlers to NS.addon at load, registers its DropAdded, DropUpdated and
# AskStateChanged receivers on a NS.Bus target at load, and adds its removal sink to NS.LootFeed
# (above) at load. NS.LootFeed, NS.Asks, NS.Window,
# NS.WindowGroup, NS.WindowCells, NS.Setting and the host handlers are read at call time: the frame
# is built on the first toast.
modules\Toast.lua
# Conventional: publishes NS.AutoAsk, the opt-in auto-ask; appends its ENCOUNTER_START,
# ENCOUNTER_END, GROUP_ROSTER_UPDATE, PLAYER_ENTERING_WORLD and ZONE_CHANGED_NEW_AREA rows (after
# modules\Roster.lua's, modules\Situations.lua's, modules\Inspect.lua's and modules\Asks.lua's) to
# NS.FEATURE_EVENTS and its STAND_DOWN / STAND_UP steps and handlers to NS.addon at load, and
# registers its DropAdded, DropUpdated, AskStateChanged and HistoryChanged receivers on a NS.Bus
# target at load. NS.LootFeed, NS.Toast's qualifier, NS.Asks, NS.Roster, NS.Restrictions,
# NS.History, NS.Setting and NS.AskTargetOf are read at call time.
modules\AutoAsk.lua
# Conventional: core\DebugLogSetup.lua's descriptor reads NS.Diagnostics at RUN time.
modules\Diagnostics.lua

# Settings (last -- depend on everything else being initialized)
# LOAD-BEARING: publishes Settings.SchemaLib, which settings\Schema.lua calls :New on at file scope.
settings\SchemaSetup.lua
# LOAD-BEARING: publishes Settings.Schema and NS.SchemaRuntime; settings\OptionsSetup.lua,
# settings\Panel.lua and settings\Slash.lua read NS.SchemaRuntime at load.
settings\Schema.lua
# LOAD-BEARING: appends every hand-written row to NS.SchemaRuntime at file scope; reads NS.C,
# NS.Constants, Settings.StampClosureRows and NS.QualityGate, NS.WindowFooter, NS.WindowGroup
# (modules\, above) at load.
settings\SchemaRows.lua
# LOAD-BEARING: publishes the LibKa0s-Options instance as Settings.Helpers; settings\Panel.lua calls
# Helpers.MasterControls at file scope.
settings\OptionsSetup.lua
# LOAD-BEARING: reads NS.C, Settings.Helpers and NS.SchemaRuntime.AddRows at file scope.
settings\Panel.lua
# LOAD-BEARING: publishes Settings.Editors (the pure halves of the pages' own editors), which
# settings\PageEditors.lua takes at load; reads NS.L, NS.Constants and NS.ClassData at load, and
# NS.Evaluate and NS.Messaging (modules\, above) at call time.
settings\Editors.lua
# LOAD-BEARING: publishes Settings.PageEditors, which settings\Pages.lua takes at load; takes
# Settings.Editors (above) at load and the engine modules at call time.
settings\PageEditors.lua
# LOAD-BEARING: registers the Feed, Comparison, Trade, Messages and Window pages after General's
# (settings\Panel.lua, above) and before Profiles' (below), the order the settings list shows.
settings\Pages.lua
# Conventional: publishes NS.SlashVerbs, the slash-only feature verbs' handlers, which
# settings\Slash.lua's NS.COMMANDS calls at RUN time; reads NS.L at load and every module above
# at call time.
settings\SlashVerbs.lua
# LOAD-BEARING: captures NS.SchemaRuntime.Get/Set/FindRow/ApplyDefault at load.
settings\Slash.lua
# LAST, so its RegisterOptionsPage call queues behind every other page's (options-ui-§3).
settings\Profiles.lua
